{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    // Respect .gitignore, so build output, vendored trees and scratch
    // checkouts are never linted.
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**/*.ts", "test/**/*.ts", "bin/**/*.js"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // The CLI writes to stdout and stderr on purpose.
        "noConsole": "off",
        // This package's output *is* GitHub Actions expressions and shell
        // parameter expansions in string literals, not JS interpolation.
        "noTemplateCurlyInString": "off"
      },
      "style": {
        // `noUncheckedIndexedAccess` is enabled, so `!` is the intended escape
        // for an access the code has already bounds-checked.
        "noNonNullAssertion": "off"
      }
    }
  }
}
