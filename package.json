{
  "name": "righthook",
  "version": "0.1.0",
  "description": "Deploy a lefthook git-hook configuration and a matching GitHub Actions pipeline into any repository.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "righthook": "./bin/righthook.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "presets",
    "workflows",
    ".righthook",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/scripts/emit-presets.js",
    "lint": "biome ci src test bin",
    "format": "biome check --write src test bin",
    "prepare": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "check": "npm run build && npm run lint && npm run test",
    "presets": "node dist/scripts/emit-presets.js"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.10.2",
    "@types/prompts": "^2.4.9",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "lefthook",
    "git-hooks",
    "lint",
    "pre-commit",
    "github-actions",
    "code-quality"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heretek-AI/righthook.git"
  },
  "homepage": "https://github.com/Heretek-AI/righthook",
  "bugs": {
    "url": "https://github.com/Heretek-AI/righthook/issues"
  },
  "packageManager": "npm@11.15.0"
}
